{
  "name": "strata-local",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "model:worker": "docker compose -f docker-compose.inference.yml up -d",
    "model:worker:logs": "docker compose -f docker-compose.inference.yml logs -f strata-ollama-worker",
    "model:worker:down": "docker compose -f docker-compose.inference.yml down",
    "model:gpu": "docker compose -f docker-compose.inference.yml -f docker-compose.gpu.yml up -d",
    "model:gpu:logs": "docker compose -f docker-compose.inference.yml -f docker-compose.gpu.yml logs -f strata-ollama-worker",
    "model:gpu:down": "docker compose -f docker-compose.inference.yml -f docker-compose.gpu.yml down"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
