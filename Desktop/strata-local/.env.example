# Default local Ollama fallback.
STRATA_OLLAMA_BASE_URL=http://localhost:11434

# Use the Docker worker for photo analysis when it is running.
# Start it on a laptop with: npm run model:worker
# Start it on a GPU server with: npm run model:gpu
# Then restart Next.js with this value enabled.
# STRATA_VISION_OLLAMA_BASE_URL=http://localhost:11435

# Optional: when a photo is analyzed, start the Docker worker if localhost:11435 is not reachable.
# Leave this off unless the station is allowed to run Docker.
# STRATA_AUTO_START_DOCKER_WORKER=true

# Keep ticket/report generation local, or point these at another worker.
# STRATA_TICKET_OLLAMA_BASE_URL=http://localhost:11434
# STRATA_REPORT_OLLAMA_BASE_URL=http://localhost:11434

# Number of vision models used in the evidence consensus pass.
STRATA_VISION_ENSEMBLE=3

# Models pulled by the Docker worker at startup.
STRATA_PULL_MODELS="qwen3-vl:32b qwen2.5vl:32b gemma3:27b gpt-oss:20b"
